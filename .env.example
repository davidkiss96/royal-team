# Sanity (docs/architecture.md Section 6) — not secret, safe to expose to the client.
# Must match studio/.env.example's SANITY_STUDIO_PROJECT_ID/DATASET — same
# Sanity project, two separate apps (this Next.js frontend + the standalone
# Studio in studio/), so each needs its own env file with the same values.
# Read by the Sanity client foundation (src/lib/sanity/client.ts). Not yet
# consumed by any page's content (docs/content-model.md-driven queries and
# the mock-data migration are a later implementation step) — this configures
# the Studio's schema/project and the Next.js app's read-only client.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Transactional email provider for contact-form forwarding (docs/architecture.md Section 11)
# Provider still open (Resend or equivalent) — this key name is a placeholder until decided.
EMAIL_PROVIDER_API_KEY=

# Business contact-form recipient address is stored in Sanity (BusinessSettings.email),
# not here — see docs/content-model.md Section 7. Nothing else is required for v1:
# no database URL, no auth secret, no object-storage credentials (docs/architecture.md
# Sections 7 and 12 — this app has neither).
