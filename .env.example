# Sanity (docs/architecture.md Section 6) — not secret, safe to expose to the client.
# One source for both the public site's read-only client
# (src/lib/sanity/client.ts) and the embedded Studio at /studio
# (sanity.config.ts, sanity.cli.ts).
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Transactional email provider for contact-form forwarding (docs/architecture.md Section 9/11).
# Resend is the confirmed provider. Server-only — never exposed to the client.
# Create at https://resend.com/api-keys.
RESEND_API_KEY=

# Verified Resend sender address (or "Name <address@domain>") for the same
# forwarding flow — must be on a domain verified in the Resend dashboard.
# This is the From address; the visitor's own email is set as Reply-To per
# submission, so replying to a forwarded message reaches the customer directly.
RESEND_FROM_EMAIL=

# Business contact-form recipient address is stored in Sanity (BusinessSettings.email),
# not here — see docs/content-model.md Section 7. No database URL, no auth
# secret, no object-storage credentials (docs/architecture.md Sections 7 and
# 12 — this app has neither).

# Environment-aware SEO/indexing (src/lib/site-config.ts, release-audit
# Section 2). Leave BOTH unset here — that's the safe, non-indexable
# default this file (.env.local) should always build with, including for
# `npm run cf:build`/`cf:preview` (local Cloudflare-runtime validation).
#
# IMPORTANT: because both are NEXT_PUBLIC_-prefixed, Next.js inlines
# whichever value is set HERE — the build-time environment — into the
# compiled app; a Cloudflare Dashboard "Variable" does NOT affect either one
# (the app is already built by the time a deployed Worker runs). The one
# real production build sets NEXT_PUBLIC_SITE_ENV=production itself, via
# `npm run cf:deploy`'s script in package.json — never by hand here, and
# never via the Cloudflare dashboard.
NEXT_PUBLIC_SITE_ENV=

# Optional: this build's own absolute origin, used for canonical/OG/Twitter
# URLs ONLY when NEXT_PUBLIC_SITE_ENV isn't "production" (falls back to
# http://localhost:3000 if unset). Only relevant if a genuinely separate
# preview deployment (its own Worker/build) is ever set up — set it in
# THAT build's own env, the same way `cf:deploy` sets NEXT_PUBLIC_SITE_ENV.
# Never hardcode a preview URL in source, and never set this to the
# production domain.
NEXT_PUBLIC_SITE_URL=
