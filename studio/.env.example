# Sanity Studio (this standalone app only). Must reference the SAME Sanity
# project/dataset as the Next.js frontend's NEXT_PUBLIC_SANITY_PROJECT_ID /
# NEXT_PUBLIC_SANITY_DATASET (see the root .env.example) — two separate env
# files because Studio and the frontend are two separate apps, not two
# separate projects.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production
