{
  "name": "royal-team",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "studio": "npm --prefix studio run dev",
    "seed:sanity": "node --no-warnings --env-file=.env.local src/scripts/seed-sanity.ts",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "echo '--- Cloudflare PREVIEW upload (staging alias) -- production traffic is NOT affected ---' && NEXT_PUBLIC_SITE_ENV=preview NEXT_PUBLIC_SITE_URL=https://preview.royalteamszerviz.hu opennextjs-cloudflare build && opennextjs-cloudflare upload --preview-alias staging",
    "cf:preview:local": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "echo '--- Cloudflare PRODUCTION deploy ---' && NEXT_PUBLIC_SITE_ENV=production opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "@portabletext/react": "^8.0.1",
    "@portabletext/types": "^4.0.2",
    "@sanity/client": "^8.6.1",
    "@sanity/image-url": "^2.1.1",
    "lucide-react": "^1.41.0",
    "next": "^16.3.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "resend": "^6.27.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^16.3.4",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2",
    "wrangler": "^4.131.1"
  },
  "allowScripts": {
    "esbuild@0.25.4": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "unrs-resolver@1.12.2": true,
    "workerd@1.20260911.1": true
  }
}
